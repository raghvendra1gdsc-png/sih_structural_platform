# .env.example — copy to .env and fill in real values
# NEVER commit the real .env to version control.
# All secrets must come from environment variables.

# --- Database ---
POSTGRES_USER=sih_user
POSTGRES_PASSWORD=sih_password
POSTGRES_DB=weather_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sih_user:sih_password@db:5432/weather_db

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- Celery Task Queue ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Backend ---
BACKEND_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production-use-a-long-random-string
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend ---
FRONTEND_PORT=3000
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Map Tiles ---
# MapTiler Cloud — sign up free at https://maptiler.com
MAPTILER_API_KEY=your_maptiler_key_here
NEXT_PUBLIC_MAPTILER_KEY=your_maptiler_key_here
# CARTO Basemaps — request key at https://carto.com/basemaps/apikey
CARTO_API_KEY=your_carto_key_here
NEXT_PUBLIC_CARTO_API_KEY=your_carto_key_here

# --- Weather Data Providers ---
# OpenWeatherMap — https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_key_here

# WeatherAPI.com — https://www.weatherapi.com (backup / UV / astronomy)
WEATHERAPI_KEY=your_weatherapi_key_here

# Tomorrow.io — https://app.tomorrow.io (nowcasting + severe weather alerts)
TOMORROW_IO_API_KEY=your_tomorrow_io_key_here

# Open-Meteo — no key required (free, zero-registration API)
# OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# --- AI / LLM Providers (WeatherGPT reasoning engine) ---
# Active backend: "openai" | "gemini" | "none"
# When set to "none", WeatherGPT degrades gracefully to structured forecast display.
LLM_BACKEND=openai

# OpenAI — https://platform.openai.com
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini

# Google AI Studio / Gemini — https://aistudio.google.com
GOOGLE_AI_STUDIO_KEY=your_google_ai_studio_key_here
GEMINI_MODEL=gemini-1.5-flash

# --- Optional: Reddit (PRAW) — leave blank to disable ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=SIHWeatherPlatform/1.0

# --- Prohibited sources (not implemented) ---
# X/Twitter API: NOT USED (pricing/reliability constraints)
# Sentinel Hub:  NOT USED (licensing incompatible with hackathon scope)
# NCS direct feed: NOT USED (no stable public API)
